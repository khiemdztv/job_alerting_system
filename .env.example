# Telegram Bot Token (obtain from @BotFather on Telegram)
VIECLAMBOT_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VIECLAMBOT_ADMIN_CHAT_ID=your_telegram_chat_id_here

# AWS Configuration
VIECLAMBOT_AWS_REGION=ap-southeast-1
VIECLAMBOT_DYNAMODB_JOBS_TABLE=vieclambot-jobs
VIECLAMBOT_DYNAMODB_USERS_TABLE=vieclambot-users
VIECLAMBOT_DYNAMODB_SUBSCRIPTIONS_TABLE=vieclambot-subscriptions
VIECLAMBOT_S3_DATA_LAKE_BUCKET=vieclambot-data-lake-your_bucket_id_here
VIECLAMBOT_SQS_RAW_JOBS_QUEUE=vieclambot-raw-jobs

# Scraper APIs
VIECLAMBOT_JOOBLE_API_KEY=your_jooble_api_key_here

# You.com real-time web search. In AWS, prefer YOU_API_KEY_SECRET_ARN instead
# of storing the key directly in the Lambda environment.
VIECLAMBOT_YOU_SEARCH_ENABLED=false
VIECLAMBOT_YOU_API_KEY=
VIECLAMBOT_YOU_API_KEY_SECRET_ARN=
VIECLAMBOT_YOU_SEARCH_COUNT=25
VIECLAMBOT_YOU_SEARCH_TIMEOUT_SECONDS=8
VIECLAMBOT_YOU_SEARCH_FRESHNESS=week

# Search, alerts and scraper coverage
VIECLAMBOT_ALERT_RECOVERY_DAYS=7
VIECLAMBOT_ALERT_MAX_JOBS_PER_USER=15
VIECLAMBOT_SEARCH_RESULT_LIMIT=100
VIECLAMBOT_INTERACTIVE_SEARCH_MAX_AGE_DAYS=7
VIECLAMBOT_MAX_SUBSCRIPTIONS=10
VIECLAMBOT_SCRAPE_WORKERS=4
VIECLAMBOT_SCRAPE_MAX_PAGES=5

# Logging
VIECLAMBOT_LOG_LEVEL=INFO
